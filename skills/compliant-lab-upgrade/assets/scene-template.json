{
  "id": "subject.experiment_id",
  "title": "实验名称",
  "subject": "physics",
  "grade": "高中",
  "description": "一句话说明实验目标与可观察现象。",
  "params": [
    {
      "key": "length",
      "label": "摆长",
      "unit": "m",
      "min": 0.1,
      "max": 2.0,
      "step": 0.01,
      "default": 1.0
    }
  ],
  "records": [
    {
      "key": "period",
      "label": "周期",
      "unit": "s",
      "kind": "number"
    }
  ],
  "meta": {
    "dslVersion": "2.0.0",
    "license": "Proprietary",
    "author": "Your Name",
    "attribution": [
      {
        "project": "owner/repo",
        "license": "Apache-2.0",
        "idea": "仅参考公开算法思想或教学呈现方式，说明具体参考了什么",
        "codeReused": false
      }
    ],
    "pedagogy": {
      "objectives": ["能测量并解释 X 与 Y 的关系"],
      "knowledge": ["subject.topic.key_concept"],
      "difficulty": 2,
      "prerequisites": ["subject.prerequisite"]
    },
    "tags": ["物理", "测量", "拟合"]
  },
  "solver": {
    "kind": "ode",
    "solver": "rk45",
    "dt": 0.01,
    "rtol": 1e-8,
    "atol": 1e-10,
    "tEnd": 10,
    "equations": ["omega", "-(gravity/length)*sin(theta)"],
    "stateNames": ["theta", "omega"],
    "paramNames": ["length", "gravity"],
    "initial": [0.2618, 0],
    "energy": "0.5*length^2*omega^2 + gravity*length*(1-cos(theta))",
    "events": [
      { "id": "lowest-point", "expression": "omega" }
    ]
  },
  "analysis": {
    "fit": { "model": "linear", "x": "length", "y": "period" },
    "uncertainty": { "method": "gum" },
    "spectrum": { "signal": "theta", "sampleRate": 100 },
    "outliers": { "method": "iqr" }
  }
}
