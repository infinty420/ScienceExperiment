{
  "id": "physics.free_fall",
  "title": "自由落体运动测定",
  "physics": {
    "gravity": 9.8
  },
  "camera": {
    "position": [
      14,
      9,
      16
    ],
    "target": [
      0,
      5,
      0
    ]
  },
  "ground": {
    "size": 20
  },
  "objects": [
    {
      "id": "ball",
      "type": "sphere",
      "size": [
        0.3
      ],
      "position": [
        0,
        10,
        0
      ],
      "mass": 1,
      "color": "#d08a3e",
      "friction": 0.1,
      "restitution": 0
    }
  ],
  "params": [
    {
      "id": "height",
      "label": "下落高度",
      "min": 1,
      "max": 20,
      "step": 0.5,
      "value": 10,
      "unit": "m"
    },
    {
      "id": "gravity",
      "label": "重力加速度",
      "min": 1.6,
      "max": 24.8,
      "step": 0.1,
      "value": 9.8,
      "unit": "m/s²"
    }
  ],
  "records": [
    {
      "id": "t",
      "label": "t (s)",
      "digits": 2,
      "sigma": 0.2
    },
    {
      "id": "y",
      "label": "y (m)",
      "digits": 3
    },
    {
      "id": "v",
      "label": "v (m/s)",
      "digits": 3
    }
  ],
  "curve": {
    "x": "t",
    "y": "v",
    "title": "v – t 图（斜率 = g）"
  },
  "guide": "设置下落高度与重力加速度（1.6=月球，9.8=地球，24.8=木星），点击「开始」释放小球。落地后由 h = ½gt² 反推重力加速度，与设定值对比。",
  "instruments": [
    {
      "id": "sw",
      "type": "stopwatch",
      "label": "机械秒表",
      "unit": "s",
      "digits": 2,
      "recordColumn": "t"
    }
  ],
  "exam": {
    "timeLimitSec": 480,
    "goals": [
      {
        "metric": "g",
        "expectFromParam": "gravity",
        "tolerance": 0.6,
        "weight": 60
      },
      {
        "minRecords": 3,
        "weight": 20
      }
    ],
    "checklist": [
      "下落高度",
      "开始实验",
      "仪器读数"
    ]
  },
  "meta": {
    "dslVersion": "2.0.0",
    "version": "1.0.0",
    "subject": "physics",
    "difficulty": 2,
    "authors": [
      "智实验项目组"
    ],
    "license": "Proprietary",
    "attribution": [
      {
        "project": "novasolver/physics-simulators",
        "license": "MIT",
        "kind": "idea",
        "url": "https://github.com/novasolver/physics-simulators",
        "note": "参考「参数—求解—可视化」统一模板组织实验"
      }
    ],
    "pedagogy": {
      "objectives": [
        "自由落体运动测定"
      ],
      "competencies": [
        "观察与测量",
        "数据处理",
        "误差分析"
      ]
    },
    "tags": [
      "physics",
      "V3"
    ]
  },
  "solver": {
    "kind": "ode",
    "solver": "rk4",
    "dt": 0.02,
    "tEnd": 2,
    "equations": [
      "v",
      "-gravity"
    ],
    "stateNames": [
      "y",
      "v"
    ],
    "paramNames": [
      "gravity"
    ],
    "initial": [
      10,
      0
    ],
    "note": "自由落体 y″=-g；v-t 线性拟合斜率即重力加速度"
  },
  "analysis": {
    "fit": {
      "model": "linear",
      "xColumn": "t",
      "yColumn": "v"
    },
    "uncertainty": {
      "expression": "2*h/t^2",
      "params": [
        "h",
        "t"
      ],
      "sigmas": [
        0.01,
        0.02
      ]
    }
  }
}
