{
  "id": "physics.pendulum",
  "title": "单摆测重力加速度",
  "camera": {
    "position": [
      0,
      2.2,
      7
    ],
    "target": [
      0,
      1.8,
      0
    ]
  },
  "objects": [
    {
      "id": "anchor",
      "type": "sphere",
      "size": [
        0.08
      ],
      "position": [
        0,
        3.2,
        0
      ],
      "color": "#9fb3c8",
      "noPhysics": true
    },
    {
      "id": "ball",
      "type": "sphere",
      "size": [
        0.16
      ],
      "position": [
        0.52,
        2.24,
        0
      ],
      "color": "#3f8f79",
      "noPhysics": true
    }
  ],
  "params": [
    {
      "id": "length",
      "label": "摆长 L",
      "min": 0.5,
      "max": 2,
      "step": 0.05,
      "value": 1,
      "unit": "m"
    },
    {
      "id": "angle",
      "label": "初始摆角",
      "min": 5,
      "max": 30,
      "step": 1,
      "value": 15,
      "unit": "°"
    },
    {
      "id": "gravity",
      "label": "重力加速度",
      "min": 1.6,
      "max": 24.8,
      "step": 0.1,
      "value": 9.8,
      "unit": "m/s²"
    }
  ],
  "records": [
    {
      "id": "n",
      "label": "周期序号",
      "digits": 0
    },
    {
      "id": "T",
      "label": "T (s)",
      "digits": 3,
      "sigma": 0.2
    }
  ],
  "curve": {
    "x": "n",
    "y": "T",
    "title": "各周期测量值 T"
  },
  "guide": "单摆做小角度摆动，摆球每次同向经过最低点记为一个完整周期。测得平均周期后代入 g = 4π²L / T²，与设定重力加速度对比。注意 T 与摆球质量无关，仅随 L 变化。",
  "instruments": [
    {
      "id": "sw",
      "type": "stopwatch",
      "label": "机械秒表",
      "unit": "s",
      "digits": 2,
      "recordColumn": "T"
    }
  ],
  "exam": {
    "timeLimitSec": 600,
    "goals": [
      {
        "metric": "g",
        "expectFromParam": "gravity",
        "tolerance": 0.5,
        "weight": 60
      },
      {
        "minRecords": 5,
        "weight": 20
      }
    ],
    "checklist": [
      "摆长",
      "开始实验",
      "仪器读数"
    ]
  },
  "meta": {
    "dslVersion": "2.0.0",
    "version": "1.0.0",
    "subject": "physics",
    "difficulty": 2,
    "authors": [
      "智实验项目组"
    ],
    "license": "Proprietary",
    "attribution": [
      {
        "project": "myphysicslab/myphysicslab",
        "license": "Apache-2.0",
        "kind": "algorithm",
        "url": "https://github.com/myphysicslab/myphysicslab",
        "note": "仅参考自适应步长与能量系统分层思想；ODE 求解器为独立实现"
      },
      {
        "project": "PhET Interactive Simulations",
        "license": "GPL-3.0",
        "kind": "pedagogy",
        "url": "https://phet.colorado.edu",
        "note": "仅参考探究式参数反馈理念；未使用其代码、资源、名称与商标"
      }
    ],
    "pedagogy": {
      "objectives": [
        "单摆测重力加速度"
      ],
      "competencies": [
        "观察与测量",
        "数据处理",
        "误差分析"
      ]
    },
    "tags": [
      "physics",
      "V3"
    ]
  },
  "solver": {
    "kind": "ode",
    "solver": "rk45",
    "dt": 0.01,
    "rtol": 1e-8,
    "atol": 1e-10,
    "tEnd": 10,
    "equations": [
      "omega",
      "-(gravity/length)*sin(theta)"
    ],
    "stateNames": [
      "theta",
      "omega"
    ],
    "paramNames": [
      "length",
      "gravity"
    ],
    "initial": [
      0.2618,
      0
    ],
    "energy": "0.5*length^2*omega^2 + gravity*length*(1-cos(theta))",
    "events": [
      {
        "id": "lowest-point",
        "expression": "omega"
      }
    ],
    "note": "非线性单摆方程（不做小角度近似），能量表达式用于守恒诊断"
  },
  "analysis": {
    "fit": {
      "model": "linear",
      "xColumn": "n",
      "yColumn": "T"
    },
    "uncertainty": {
      "expression": "4*pi^2*L/T^2",
      "params": [
        "L",
        "T"
      ],
      "sigmas": [
        0.002,
        0.01
      ]
    },
    "outliers": true
  }
}
