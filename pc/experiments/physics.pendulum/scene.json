{
  "id": "physics.pendulum",
  "title": "单摆测重力加速度",
  "camera": { "position": [0, 2.2, 7], "target": [0, 1.8, 0] },
  "objects": [
    {
      "id": "anchor",
      "type": "sphere",
      "size": [0.08],
      "position": [0, 3.2, 0],
      "color": "#9fb3c8",
      "noPhysics": true
    },
    {
      "id": "ball",
      "type": "sphere",
      "size": [0.16],
      "position": [0.52, 2.24, 0],
      "color": "#3f8f79",
      "noPhysics": true
    }
  ],
  "params": [
    { "id": "length", "label": "摆长 L", "min": 0.5, "max": 2, "step": 0.05, "value": 1, "unit": "m" },
    { "id": "angle", "label": "初始摆角", "min": 5, "max": 30, "step": 1, "value": 15, "unit": "°" },
    { "id": "gravity", "label": "重力加速度", "min": 1.6, "max": 24.8, "step": 0.1, "value": 9.8, "unit": "m/s²" }
  ],
  "records": [
    { "id": "n", "label": "周期序号", "digits": 0 },
    { "id": "T", "label": "T (s)", "digits": 3 }
  ],
  "curve": { "x": "n", "y": "T", "title": "各周期测量值 T" },
  "guide": "单摆做小角度摆动，摆球每次同向经过最低点记为一个完整周期。测得平均周期后代入 g = 4π²L / T²，与设定重力加速度对比。注意 T 与摆球质量无关，仅随 L 变化。"
}
